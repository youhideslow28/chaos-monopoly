# ==============================================================================
# CHAOS MONOPOLY — ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env.local for local development or set in your deployment orchestrator.
# Do NOT commit real secrets or production credentials into version control.
# ==============================================================================

# Application Environment
NODE_ENV=production

# Authoritative Multiplayer Server Network Configuration
MULTIPLAYER_HOST=0.0.0.0
MULTIPLAYER_PORT=3001
PORT=3001

# SQLite WAL Database Persistence Path
MULTIPLAYER_DB_PATH=./data/chaos-multiplayer.sqlite

# Security & CORS: Comma-separated allowed origins (Leave empty or set '*' for local dev)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://chaos-monopoly.local

# Rate Limiting Hardening (Sliding Window)
RATE_LIMIT_MAX_REQUESTS=35
RATE_LIMIT_WINDOW_MS=5000

# Reconnection & Room Lifecycle Policy
RECONNECT_GRACE_MS=60000
ROOM_EXPIRATION_MS=7200000
AI_ACTION_DELAY_MS=550

# Client Frontend WebSocket Endpoint (Optional - defaults to relative /ws or hostname:3001/ws)
VITE_MULTIPLAYER_PORT=3001
# VITE_WS_URL=wss://chaos-monopoly.example.com/ws
